# Copy to .env and adjust. Only ANNOY_ANNOUNCED_IP is required for Docker.
ANNOY_NAME=Annoy
# Public IP first (friends outside), LAN IP second (people at home).
ANNOY_ANNOUNCED_IP=203.0.113.10,192.168.0.10
# open | invite | closed (the instance admin can change it later in the app)
ANNOY_REGISTRATION=invite
# Optional: "Sign in with Discord"
ANNOY_DISCORD_CLIENT_ID=
ANNOY_DISCORD_CLIENT_SECRET=
ANNOY_PUBLIC_URL=
# Optional: relay voice through Cloudflare Realtime SFU (hosts behind CGNAT)
# ANNOY_VOICE_BACKEND=cloudflare
# ANNOY_CF_SFU_APP_ID=
# ANNOY_CF_SFU_APP_TOKEN=
# Estimated monthly egress budget in GB; 80% pauses camera/screen, 95% voice. 0 disables.
# ANNOY_CF_SFU_MONTHLY_GB=1000
