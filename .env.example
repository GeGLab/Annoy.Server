# Copy to .env and adjust. Only DISTOPIC_ANNOUNCED_IP is required for Docker.
DISTOPIC_NAME=Distopic
# Public IP first (friends outside), LAN IP second (people at home).
DISTOPIC_ANNOUNCED_IP=203.0.113.10,192.168.0.10
# open | invite | closed (the instance admin can change it later in the app)
DISTOPIC_REGISTRATION=invite
# Optional: "Sign in with Discord"
DISTOPIC_DISCORD_CLIENT_ID=
DISTOPIC_DISCORD_CLIENT_SECRET=
DISTOPIC_PUBLIC_URL=
