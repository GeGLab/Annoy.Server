# Copy to .env and adjust. Only ANNOY_ANNOUNCED_IP is required for Docker.
ANNOY_NAME=Annoy
# Public IP first (friends outside), LAN IP second (people at home).
ANNOY_ANNOUNCED_IP=203.0.113.10,192.168.0.10
# Every annoy-server setting is a flag here; the app has no admin panel.
# Change a value and run `docker compose up -d`. Invites, bans, deleting
# servers and updating now: ./scripts/annoy-admin.sh (see README).
# open | invite | closed
ANNOY_REGISTRATION=invite
# Optional: username that administers this annoy-server (otherwise the first account)
# ANNOY_ADMIN=
# Optional limits
# ANNOY_MAX_UPLOAD_MB=25
# ANNOY_MAX_SERVERS_PER_USER=
# Optional: "Sign in with Discord"
ANNOY_DISCORD_CLIENT_ID=
ANNOY_DISCORD_CLIENT_SECRET=
ANNOY_PUBLIC_URL=
# Optional: online activity for linked Steam accounts (local detection needs no key).
ANNOY_STEAM_API_KEY=
# Optional: relay voice through Cloudflare Realtime SFU (hosts behind CGNAT)
# ANNOY_VOICE_BACKEND=cloudflare
# ANNOY_CF_SFU_APP_ID=
# ANNOY_CF_SFU_APP_TOKEN=
# Estimated monthly egress budget in GB; 80% pauses camera/screen, 95% voice. 0 disables.
# ANNOY_CF_SFU_MONTHLY_GB=1000
# Updates follow the newest image of ANNOY_VERSION (default "latest": every
# release of the main line, alpha for now; "0.7" stays on 0.7.x stable fixes).
# "nightly" and "unstable" are test channels, not launched yet. on = automatic; otherwise `./scripts/annoy-admin.sh update apply`.
# ANNOY_AUTO_UPDATE=on
# ANNOY_UPDATE_INTERVAL_HOURS=6
# Exclusive account mode; existing instances require explicit offline migration.
# global: required Global sign-in (default), including migration of old local users.
# local: local accounts only, with zero requests to Annoy Global.
ANNOY_ACCOUNT_MODE=global
# Remove legacy ANNOY_GLOBAL; it is no longer accepted.
# Do not combine contradictory flags.

# Optional GIPHY browser/client API key, exposed only to authenticated clients.
# GIPHY_CLIENT_API_KEY=

# Remote clients require HTTPS/WSS; set the stable public origin behind a proxy.
# ANNOY_PUBLIC_URL=https://chat.example.org
# Trust forwarding headers only from these explicit IP/CIDR peers (default: none).
# Never use a universal range or expose a trusted reverse proxy without stripping spoofed headers.
# ANNOY_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Oldest client version this instance accepts (default: the version this server requires).
# ANNOY_MIN_CLIENT_VERSION=0.11.0-alpha.1
# Restrict browser origins to the actual deployment. Desktop file origin is null.
# ANNOY_ALLOWED_ORIGINS=null,https://chat.example.org
