{
  "name": "distopic-server",
  "version": "0.2.0",
  "private": true,
  "description": "Self-hosted voice and text chat server: TeamSpeak-style hosting with Discord-style features",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test:profile": "node --import tsx --test tests/profile-media.test.ts",
    "test:discovery": "node --import tsx --test tests/discovery.test.ts",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p . && tsc -p packages/protocol"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@distopic/protocol": "*",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.12.7",
    "mediasoup": "^3.32.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "mediasoup@3.32.0": true,
    "esbuild@0.28.2": true
  }
}
