{
  "name": "annoy-server",
  "version": "0.9.3",
  "private": true,
  "description": "Self-hosted voice and text chat server: TeamSpeak-style hosting with Discord-style features",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test:social": "node --import tsx --test tests/social-media.test.ts",
    "test:profile": "node --import tsx --test tests/profile-media.test.ts",
    "test:discovery": "node --import tsx --test tests/discovery.test.ts",
    "test:steam": "node --import tsx --test tests/steam.test.ts",
    "test:ownership": "node --import tsx --test tests/ownership.test.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p . && tsc -p packages/protocol",
    "account:recover": "tsx scripts/account-recovery.ts",
    "account:link": "tsx scripts/link-public-id.ts",
    "test:accounts": "node --import tsx --test tests/account-policy.test.ts",
    "test:global": "node --import tsx --test tests/global.test.ts",
    "test:channels": "node --import tsx --test tests/channel-types.test.ts",
    "test:presence": "node --import tsx --test tests/activity-presence.test.ts",
    "test:updates": "node --import tsx --test tests/updates.test.ts",
    "test:disconnect": "node --import tsx --test tests/disconnect.test.ts tests/shutdown.test.ts",
    "account:mode": "tsx scripts/account-mode.ts",
    "test:security": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "content:legacy": "tsx scripts/legacy-content.ts",
    "test:history": "node --import tsx --test tests/history.test.ts",
    "test:privacy": "node --import tsx --test tests/profile-privacy.test.ts"
  },
  "engines": {
    "node": ">=24.7"
  },
  "dependencies": {
    "@distopic/protocol": "*",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.12.7",
    "ipaddr.js": "2.5.0",
    "jose": "6.2.14",
    "mediasoup": "^3.32.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "mediasoup@3.32.0": true,
    "esbuild@0.28.2": true
  }
}
